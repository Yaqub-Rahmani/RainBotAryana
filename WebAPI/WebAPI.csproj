		</None>
		<None Update="..\libs\zk\zkfpslibLow.dll">
			<Link>native\zkfpslibLow.dll</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="..\libs\zk\ztrace_maps.dll">
			<Link>native\ztrace_maps.dll</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
